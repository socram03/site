---
import '../styles/global.css';

const {
  title = 'socram09 — internet desk',
  description = 'A small digital desk full of projects, cats, and avoidable frontend incidents.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="socram09" />
    <meta name="theme-color" content="#211820" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
  </body>
</html>
